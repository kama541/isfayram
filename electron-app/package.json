{
  "name": "isfayram-pos-desktop",
  "version": "1.0.27",
  "description": "Isfayram Restaurant POS - Desktop App (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "uz.isfayram.pos",
    "productName": "Isfayram POS",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Isfayram POS"
    },
    "files": [
      "main.js",
      "preload.js",
      "receipt-template.html",
      "logo.png",
      "ui/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^24.0.0"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
